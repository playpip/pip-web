# Copy to .env.local for local testing. In production the build runs in GitHub
# Actions (deploy-cloudflare-pages.yaml), so production values live as GitHub
# Actions Variables, NOT in Cloudflare Pages. All NEXT_PUBLIC_* vars are baked
# into the client bundle at build time.

# Anonymous, cookieless analytics (Umami). The tracking tag only renders in a
# production build AND only when this id is set — leave it empty and there is no
# analytics tag at all. Get the id from the Umami dashboard: Settings → Websites
# → (playpip.io) → the "Website ID".
#
# Production: set it as a repo Variable (Settings → Secrets and variables →
# Actions → Variables tab) named NEXT_PUBLIC_UMAMI_WEBSITE_ID. It's a Variable,
# not a Secret — it ships to every visitor in the bundle, nothing to hide.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional. Defaults to Umami Cloud's script. Override only if self-hosting.
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# Optional cross-device sync (Supabase). Leave both empty and sync does not
# exist: no client is created, the Settings "Account" section doesn't render,
# and the app is exactly the local-first app it was. Contributors never need a
# backend to run Pip.
#
# Production: set both as repo Variables (Settings → Secrets and variables →
# Actions → Variables tab), NOT Secrets and NOT in Cloudflare Pages. They ship
# to every visitor in the bundle, same as the Umami id above. NEXT_PUBLIC_* is
# inlined at build time, so changing either one needs a redeploy, not a save.
#
# The key is the publishable ("anon public") one. Never the service-role key:
# it bypasses Row Level Security and this bundle is public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sign-in providers offered beside email and password: any of `google`, `apple`,
# comma-separated, in the order shown. Each must be enabled in the Supabase
# dashboard (Authentication → Sign In / Providers) BEFORE it goes in here, or the
# button sends players to an error page. Setup steps: docs/sync.md. Empty → email
# only. Production: repo Variable, same as the Supabase pair.
NEXT_PUBLIC_AUTH_PROVIDERS=

# The membership's two Stripe price ids (docs/stripe.md). Leave both empty and
# the join button reads "Checkout isn't open yet" — the state every fork and
# contributor build should be in. Use test-mode ids locally.
#
# Production: repo Variables, same as the Supabase pair. They are not secret —
# a price id charges nobody on its own. The Stripe *secret* key never goes here:
# it lives only in Supabase Edge Function secrets.
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_ANNUAL=
