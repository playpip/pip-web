// The room server: one Durable Object per multiplayer table, one per
// quick-match stake. Its own Worker, beside the Pages site rather than in it —
// Pages cannot hold a Durable Object (see docs/multiplayer.md).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pip-rooms",
  // Pip's Cloudflare account (the one with the pip-web Pages project and the
  // playpip.io zone). Pinned so a deploy can never land on another account a
  // login happens to see. Not a secret.
  "account_id": "dfedd2e916065d5e424d44e78e5041f4",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "PokerRoom" },
      { "name": "QUEUES", "class_name": "Matchmaker" },
      // One per account: their slow games, notification prefs and push devices.
      { "name": "PLAYERS", "class_name": "Player" },
      // The hands-played count on the landing page. One object.
      { "name": "TALLY", "class_name": "Tally" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PokerRoom", "Matchmaker"] },
    { "tag": "v2", "new_sqlite_classes": ["Player"] },
    { "tag": "v3", "new_sqlite_classes": ["Tally"] }
  ],
  "vars": {
    // Where the site is served from. Every socket and request is checked
    // against this list, so a page on another site cannot drive a table.
    "ALLOWED_ORIGINS": "https://playpip.io,https://www.playpip.io,http://localhost:3000",
    // This Worker's own address, for the "stop these emails" link.
    "PUBLIC_URL": "https://rooms.playpip.io"
  },
  // The browser connects here directly. A custom domain on the playpip.io zone:
  // the first deploy creates its DNS record and certificate.
  "routes": [{ "pattern": "rooms.playpip.io", "custom_domain": true }],
  "observability": { "enabled": true },
  // Drains `push_outbox` (index.ts `scheduled`): somebody passed you on the board.
  "triggers": { "crons": ["*/2 * * * *"] },
  // The upload time of the running version, which /health reports, so anyone
  // can tell whether a fix merged since has reached the tables.
  "version_metadata": { "binding": "VERSION" }
  // Secrets (wrangler secret put, never in this file):
  //   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
  //   TURN_KEY_ID, TURN_KEY_API_TOKEN   (camera and mic; optional)
  //   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY (web push for slow games; scripts/vapid-keys.mjs)
  //   RESEND_API_KEY                     (slow games' turn emails)
  //   NOTIFY_SECRET                      (signs the email's off link; optional)
}
