{
  "expo": {
    "name": "Pip",
    "slug": "pip",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.playpip.app",
      "icon": "./assets/pip.icon",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Pip uses your camera only when you turn it on at a table with friends, so they can see you in your seat.",
        "NSMicrophoneUsageDescription": "Pip uses your microphone only when you turn it on at a table with friends, so you can talk while you play."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101010",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.playpip.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "backgroundColor": "#0a0a0b",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 56,
          "backgroundColor": "#0a0a0b",
          "resizeMode": "contain"
        }
      ],
      "expo-apple-authentication",
      ["expo-notifications", { "color": "#0a0a0b" }]
    ],
    "owner": "playpip",
    "extra": {
      "eas": {
        "projectId": "68178228-67f1-47d4-91c1-077904fae862"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/68178228-67f1-47d4-91c1-077904fae862"
    }
  }
}
